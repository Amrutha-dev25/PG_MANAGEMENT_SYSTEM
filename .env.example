# ---- Copy this file to ".env" and fill in YOUR values (never commit .env) ----

# MySQL (SQL database)  - database name must stay pg_management (used by database/mysql/*.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pg_management

# MongoDB (NoSQL database)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pg_management_nosql

# Secret used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_string

# Optional: passwords given to the demo accounts when the MongoDB seed runs
# (they are stored only as bcrypt hashes). Defaults: Admin@123 / Staff@123 / Resident@123
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=
# SEED_RESIDENT_PASSWORD=

# Set to true only when the site is served over HTTPS
# COOKIE_SECURE=false

# Registration codes for privileged roles (choose your own private values).
# Residents can register using a valid Resident ID already present in MySQL.
STAFF_SIGNUP_CODE=change_this_staff_code
ADMIN_SIGNUP_CODE=change_this_admin_code
